{
  "name": "protoforge",
  "private": true,
  "version": "0.1.0",
  "description": "Prompt-to-product: multi-agent AI that generates 3D CAD, electronics, firmware, BOM and assembly for hardware products",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev -w server\" \"npm:dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "vercel-build": "node scripts/build-vercel.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=20"
  }
}
